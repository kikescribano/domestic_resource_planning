# nginx de produccion (ADR-016, con el TLS de su ampliacion): la SPA, el proxy
# de /api y la entrega de ficheros de la ADR-005, en un solo proceso y con
# certificado de Let's Encrypt.
#
# Cuatro servidores porque son dos origenes y dos protocolos. Los dos del 80
# solo hacen dos cosas: contestar el desafio ACME --emitir y renovar el
# certificado sin cortar nada-- y mandar todo lo demas a su https. Los dos del
# 443 se reparten por nombre (SNI): ${DRP_APP_HOST} es la aplicacion y
# ${DRP_FILES_HOST} los ficheros firmados -- **la separacion de origen de la
# ADR-005 es por fin por dominio**, como se escribio que seria; el puerto 8081
# ya no existe.
#
# El servidor de ficheros sigue el patron de
# docker/nginx/templates/default.conf.template: si se toca alli, se toca aqui.
#
# El certificado es UNO con dos nombres (el directorio lleva el del primero,
# ${DRP_APP_HOST}); lo emite y renueva certbot en el anfitrion contra
# /srv/drp/acme, que aqui se sirve en /.well-known/acme-challenge/. Los
# detalles de emision y renovacion, en deployment.md.

# El formato de log de los ficheros: registra $uri y **no $request**, que
# incluiria la firma completa de una URL todavia valida (condicion de la
# ADR-005).
log_format drp_files '$remote_addr [$time_local] "$request_method $uri" $status $body_bytes_sent';

# ---------------------------------------------------------------------------
# Puerto 80: ACME y redireccion. Nada mas se sirve en claro.
# ---------------------------------------------------------------------------
server {
    listen 80;
    server_name ${DRP_FILES_HOST};

    location /.well-known/acme-challenge/ {
        root /srv/drp/acme;
    }

    location / {
        return 301 https://${DRP_FILES_HOST}$request_uri;
    }
}

server {
    listen 80 default_server;
    server_name _;

    location /.well-known/acme-challenge/ {
        root /srv/drp/acme;
    }

    # Tambien lo que llegue por la IP o por el nombre viejo del VPS: la unica
    # direccion publica de la aplicacion es la del dominio.
    location / {
        return 301 https://${DRP_APP_HOST}$request_uri;
    }
}

# ---------------------------------------------------------------------------
# La aplicacion: el estatico de la SPA y el proxy de /api, en 443
# ---------------------------------------------------------------------------
server {
    listen 443 ssl default_server;
    http2 on;
    server_name ${DRP_APP_HOST};

    ssl_certificate     /etc/letsencrypt/live/${DRP_APP_HOST}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DRP_APP_HOST}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    root /srv/drp/web;

    # Las cabeceras de seguridad de la SPA (hallazgo 10 de la auditoria OWASP).
    # Aqui y no en el backend, porque quien sirve el frontend en produccion es
    # este nginx (ADR-016): el estatico no pasa por Spring y sus cabeceras solo
    # pueden nacer aqui. `always` para que salgan tambien en los errores. A las
    # respuestas proxyadas de /api les caen encima ademas de las que Spring
    # Security ya pone, y repetir `nosniff` es inocuo.
    #
    # **Se repiten dentro de /assets/ y de /index.html, y no es descuido**:
    # nginx hereda las `add_header` de arriba solo si el `location` no declara
    # ninguna, y esos dos declaran su Cache-Control. Es la misma trampa que el
    # servidor de ficheros documenta mas abajo.
    #
    # La CSP esta medida contra el artefacto construido, no supuesta:
    # - `script-src 'self'` sin `unsafe-eval` ni `wasm-unsafe-eval`: la
    #   conversion HEIC usa la variante csp de heic-to (ADR-014), que es
    #   JavaScript puro compilado con wasm2js -- el chunk construido no contiene
    #   ni una llamada a eval ni a WebAssembly.
    # - `worker-src blob:`: ese mismo chunk monta su Worker con
    #   URL.createObjectURL.
    # - `style-src 'unsafe-inline'`: React pinta atributos style= (los colores
    #   de categoria de la ADR-015, entre otros) y para la CSP el atributo es
    #   estilo en linea.
    # - `img-src` incluye el otro origen: las imagenes firmadas viven en
    #   ${DRP_FILES_PUBLIC_URL} (ADR-005) y se pintan con <img>.
    # - Todo lo demas es de origen propio: la SPA se sirve sus propias fuentes
    #   woff2 y no llama a ningun tercero.
    add_header X-Content-Type-Options "nosniff" always;
    add_header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' ${DRP_FILES_PUBLIC_URL}; font-src 'self'; connect-src 'self'; worker-src 'self' blob:; base-uri 'none'; form-action 'self'; frame-ancestors 'none'" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    # El HSTS que esperaba comentado a que hubiera TLS, encendido el dia que lo
    # hubo. Solo sobre https, como la RFC 6797 manda; el backend sabe decir
    # request.isSecure() gracias a server.forward-headers-strategy.
    add_header Strict-Transport-Security "max-age=31536000" always;

    # 25 MB por fichero mas la envoltura del multipart, como el tope de Spring:
    # sin esto nginx cortaria la subida con un 413 propio, fuera del contrato.
    client_max_body_size 26m;

    # Comprimir el texto abarata la SPA entera; las imagenes ya vienen
    # comprimidas y no se tocan.
    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # La ruta interna a la que apunta X-Accel-Redirect. `internal` significa
    # que solo se alcanza desde una redireccion interna: pedirla desde fuera da
    # 404. La aplicacion autoriza **en cada peticion** y nginx entrega los
    # bytes.
    location /internal/ {
        internal;
        alias /srv/drp/files/;
    }

    location /api/ {
        proxy_pass http://${DRP_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Una subida de 25 MB por una conexion mala tarda; los 60 s de serie la
        # cortarian a mitad.
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_request_buffering off;
    }

    # Los bundles llevan hash en el nombre: cambiar el contenido cambia la URL,
    # asi que se pueden cachear sin fecha de caducidad practica.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;

        # Las de seguridad, repetidas porque este location declara la suya y
        # con ello pierde todas las del servidor. Ver la nota de arriba.
        add_header X-Content-Type-Options "nosniff" always;
        add_header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' ${DRP_FILES_PUBLIC_URL}; font-src 'self'; connect-src 'self'; worker-src 'self' blob:; base-uri 'none'; form-action 'self'; frame-ancestors 'none'" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        add_header Strict-Transport-Security "max-age=31536000" always;

        try_files $uri =404;
    }

    # El index nunca se cachea sin revalidar: es lo unico que apunta a los
    # bundles y quedarse uno viejo es quedarse la aplicacion vieja.
    location = /index.html {
        add_header Cache-Control "no-cache" always;

        # Repetidas por lo mismo que en /assets/.
        add_header X-Content-Type-Options "nosniff" always;
        add_header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' ${DRP_FILES_PUBLIC_URL}; font-src 'self'; connect-src 'self'; worker-src 'self' blob:; base-uri 'none'; form-action 'self'; frame-ancestors 'none'" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        add_header Strict-Transport-Security "max-age=31536000" always;
    }

    # El resto es la SPA: toda ruta que no sea un fichero real --/entrar,
    # /crear-hogar, /verificar-correo...-- devuelve el index y el router de
    # React resuelve. Sin esto, el enlace de un correo de verificacion daria
    # 404.
    location / {
        try_files $uri $uri/ /index.html;
    }
}

# ---------------------------------------------------------------------------
# Los ficheros: el otro origen, ahora por subdominio (ADR-005)
# ---------------------------------------------------------------------------
server {
    listen 443 ssl;
    http2 on;
    server_name ${DRP_FILES_HOST};

    ssl_certificate     /etc/letsencrypt/live/${DRP_APP_HOST}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DRP_APP_HOST}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    access_log /var/log/nginx/files.log drp_files;

    # Las tres que no son opcionales, mas la de Referer para que la firma no
    # viaje en la cabecera de ninguna navegacion posterior. `always` para que
    # tambien salgan en las respuestas de error.
    #
    # **Se repiten dentro de cada `location`, y no es descuido.** nginx hereda
    # las `add_header` del nivel de arriba **solo si el nivel de abajo no
    # declara ninguna**: en cuanto un `location` anade una cabecera propia,
    # pierde todas las heredadas.
    add_header X-Content-Type-Options "nosniff" always;
    add_header Content-Security-Policy "default-src 'none'; sandbox" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Strict-Transport-Security "max-age=31536000" always;

    location /f/ {
        # La firma va en `s` y la caducidad en `e`. `secure_link` deja en
        # $secure_link: "" si la firma no cuadra, "0" si ha caducado, "1" si
        # vale.
        secure_link $arg_s,$arg_e;

        # El mensaje que se firma, **exactamente el mismo que arma la
        # aplicacion** en SignedFileUrls: caducidad, ruta, un espacio y el
        # secreto. El secreto va AL FINAL: md5(mensaje+secreto) no admite
        # extension de longitud y md5(secreto+mensaje) si.
        secure_link_md5 "$secure_link_expires$uri ${DRP_FILES_LINK_SECRET}";

        if ($secure_link = "") { return 403; }
        if ($secure_link = "0") { return 410; }

        alias /srv/drp/files/;

        # Las heredadas, repetidas porque este `location` declara las suyas y
        # con ello pierde las del servidor. Ver la nota de mas arriba.
        add_header X-Content-Type-Options "nosniff" always;
        add_header Content-Security-Policy "default-src 'none'; sandbox" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Strict-Transport-Security "max-age=31536000" always;

        # Siempre adjunto. NO impide que un <img> pinte la imagen: el navegador
        # solo honra Content-Disposition en navegaciones y descargas, no en
        # subrecursos.
        add_header Content-Disposition "attachment" always;

        # Los ficheros son inmutables --cambiar una foto es subir otra-- y la
        # URL caduca sola. `private` porque son de un hogar, no de la red.
        add_header Cache-Control "private, max-age=900" always;
    }

    # Nada mas se sirve desde este origen. Que no haya raiz ni listado es parte
    # del aislamiento: aqui no vive la aplicacion.
    location / {
        return 404;
    }
}
