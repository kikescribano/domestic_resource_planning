# Plantilla del .env de produccion. En el servidor:
#
#   cp .env.example .env && chmod 600 .env
#
# y rellenar TODO. Ningun valor real de estos entra jamas en el repositorio; el
# .gitignore ya excluye .env, y el arranque del backend falla a proposito si un
# secreto sigue siendo el del codigo.

# --- Base de datos -----------------------------------------------------------
# Generar cada una con:  openssl rand -base64 24
# Solo se aplican en el PRIMER arranque (el volumen de datos vacio); cambiarlas
# despues es un ALTER ROLE a mano ademas de editar esto.
DRP_DB_OWNER_PASSWORD=
DRP_DB_APP_PASSWORD=

# --- Secretos de la aplicacion ----------------------------------------------
# Generar cada uno con:  openssl rand -base64 48   (el JWT exige >= 32 bytes)
DRP_JWT_SECRET=
# Lo comparten el backend (firma) y nginx (verificacion). Si no coinciden,
# todas las imagenes dan 403 y ninguna otra cosa falla.
DRP_FILES_LINK_SECRET=

# --- URLs publicas -----------------------------------------------------------
# Sin barra final. La segunda es el otro origen de los ficheros (ADR-005):
# mismo nombre, otro puerto.
DRP_PUBLIC_URL=http://vps-7f6cfe1b.vps.ovh.net
DRP_FILES_PUBLIC_URL=http://vps-7f6cfe1b.vps.ovh.net:8081

# --- Correo saliente ---------------------------------------------------------
# Cuenta de Gmail dedicada con verificacion en dos pasos y contrasena de
# aplicacion (https://myaccount.google.com/apppasswords). El remitente es la
# propia cuenta: Gmail lo reescribiria de todos modos.
DRP_SMTP_HOST=smtp.gmail.com
DRP_SMTP_PORT=587
DRP_SMTP_USERNAME=
DRP_SMTP_PASSWORD=
DRP_MAIL_FROM=

# --- Dimensionado ------------------------------------------------------------
# Tope de hogares de la instalacion. Vacio o 0 es sin tope; el valor real del
# despliegue se decide aqui, no en el repositorio.
DRP_MAX_HOUSEHOLDS=

# --- Hogar de demostracion ---------------------------------------------------
# La contrasena de produccion de las cuatro cuentas del hogar Serrano, que
# change-demo-password.sh aplica tras cada carga del seed. La del repositorio
# es publica; esta no lo es y vive solo aqui. Minimo 12 caracteres, sin
# comillas ni barras invertidas.
DRP_DEMO_PASSWORD=

# --- Version -----------------------------------------------------------------
# Etiqueta de las imagenes de GHCR que despliega `docker compose pull`:
# `latest` o el SHA de un commit de main concreto para fijar o volver atras.
DRP_VERSION=latest
