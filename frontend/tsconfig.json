{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "useDefineForClassFields": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    // `node` entra con el Hito 2 del cierre de huecos y por una sola razon:
    // `heic.test.ts` lee de disco **un HEIC de verdad**, que es lo que separa
    // esa prueba de una que se pasaria un JPEG renombrado. Nada del repositorio
    // sabe escribir un HEIC, asi que el fichero se versiona y hay que abrirlo.
    // El precio, dicho en vez de disimulado: `process` y `Buffer` pasan a estar
    // declarados tambien para el codigo de la aplicacion, donde no existen.
    "types": ["node", "vitest/globals", "@testing-library/jest-dom"]
  },
  "include": ["src", "vite.config.ts"]
}
