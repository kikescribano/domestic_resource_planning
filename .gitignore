# Python (utillaje de documentacion y marketing)
__pycache__/
*.pyc

# Gradle y Kotlin
.gradle/
backend/build/
backend/bin/
backend/out/
# Volcados del compilador de Kotlin cuando el daemon se cae. Son de la maquina,
# no del proyecto, y se cuelan con un `git add -A` si no estan aqui.
backend/.kotlin/

# Node, Vite y Playwright
node_modules/
frontend/dist/
frontend/coverage/
frontend/playwright-report/
frontend/test-results/
frontend/.playwright/
frontend/.vite/

# Cliente TypeScript generado desde openapi.yaml: se regenera, no se versiona
frontend/src/api/generated/

# Entorno y secretos
.env
.env.*
!.env.example

# Volumenes locales levantados por compose.yaml
.data/

# Datos de produccion cuando el despliegue corre desde un checkout del repo en
# el servidor (deploy/compose.yaml monta ./data). En una maquina de desarrollo
# este directorio no deberia existir siquiera.
deploy/data/

# Worktrees de sesiones de trabajo. Cuelgan de .claude/, que si se versiona --ahi
# viven las skills del proyecto-- asi que sin esta linea aparecerian como ruido
# sin seguimiento en cada `git status`.
.claude/worktrees/

# Editores
.idea/
*.iml
.vscode/
*.swp
.DS_Store
